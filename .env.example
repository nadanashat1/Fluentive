# ==========================================
# FLUENTIVE CRM - ENTERPRISE CONFIGURATION
# ==========================================
# SaaS-ready environment variables for production deployment

# ==========================================
# REQUIRED: Core Application
# ==========================================

# Database (Supabase PostgreSQL)
# Get from: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres.nfetwmyemseyiztzgbst:OROscKkxZy1jd4gY@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# JWT Authentication (Generate strong secret: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# App URLs
FRONTEND_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ==========================================
# ENTERPRISE: Caching Layer (Redis)
# ==========================================
# Optional but HIGHLY RECOMMENDED for performance
# Get from: Upstash (https://upstash.com) or Redis Cloud
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST:6379

# ==========================================
# ENTERPRISE: Monitoring & Observability
# ==========================================
# Optional: Sentry error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# OPTIONAL: External Services
# ==========================================

# OpenAI (for AI features)
OPENAI_API_KEY=sk-your-openai-api-key

# 2FA Authentication
TWO_FACTOR_SECRET=your-2fa-secret-key

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==========================================
# CI/CD: GitHub Actions Secrets
# ==========================================
# These are set in GitHub repository settings, NOT in .env
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=your-vercel-org-id
# VERCEL_PROJECT_ID=your-vercel-project-id

# ==========================================
# DEVELOPMENT: Local Only
# ==========================================
# NODE_ENV=development
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fluentive
