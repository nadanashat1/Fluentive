STRIPE_BUSINESS_PRICE_ID=price_1H9def456ghi789

# ==========================================
# SAAS MULTI-TENANT (REQUIRED)
# ==========================================

# Default tenant for migration (set after first tenant created)
DEFAULT_TENANT_ID=tenant_default_001

# Plan Limits Configuration
FREE_PLAN_MAX_USERS=3
FREE_PLAN_MAX_LEADS=100
PRO_PLAN_MAX_USERS=10
PRO_PLAN_MAX_LEADS=1000
BUSINESS_PLAN_MAX_USERS=999999
BUSINESS_PLAN_MAX_LEADS=999999

# ==========================================
# REDIS CACHING (OPTIONAL BUT RECOMMENDED)
# ==========================================

# Upstash Redis URL (Serverless Redis)
# Get from: https://upstash.com → Create Database → Redis
REDIS_URL=rediss://default:redispassword123@redis-12345.upstash.io:6379

# ==========================================
# MONITORING & OBSERVABILITY (OPTIONAL)
# ==========================================

# Sentry Error Tracking
# Get from: https://sentry.io → Projects → Add new project → Next.js
SENTRY_DSN=https://1234567890abcdef1234567890abcdef@o123456.ingest.sentry.io/1234567

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# AI FEATURES (OPTIONAL)
# ==========================================

# OpenAI API Key
OPENAI_API_KEY=sk-1234567890abcdef1234567890abcdef12345678

# ==========================================
# EMAIL (OPTIONAL - FOR NOTIFICATIONS)
# ==========================================

# Resend (Recommended for startups)
RESEND_API_KEY=re_1234567890abcdef1234567890abcdef
FROM_EMAIL=noreply@fluentive.com

# ==========================================
# SECURITY HEADERS (NORMALLY SET IN VERCEL.JSON)
# ==========================================

# Content Security Policy (if not using vercel.json)
# CSP_HEADER=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ==========================================
# FEATURE FLAGS (SAAS GROWTH)
# ==========================================

# Enable/Disable Features
ENABLE_REFERRAL_SYSTEM=true
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_TEAM_INVITES=true

# ==========================================
# POST-LAUNCH CONFIGURATION
# ==========================================

# These should be set AFTER launch based on analytics

# Rate Limiting (requests per minute per tenant)
RATE_LIMIT_PER_TENANT=300

# AI Credits (free credits for new users)
DEFAULT_AI_CREDITS=50
REFERRAL_BONUS_CREDITS=100

# Cache TTL (seconds)
CACHE_TTL_SHORT=60      # 1 minute
CACHE_TTL_MEDIUM=300    # 5 minutes
CACHE_TTL_LONG=3600     # 1 hour
