# ==========================================
# STRIPE BILLING (REQUIRED FOR PAYMENTS)
# ==========================================

# Stripe Live Secret Key (NOT test key!)
# Get from: Stripe Dashboard → Developers → API Keys → Live Mode
STRIPE_SECRET_KEY=sk_test_51234567890abcdef1234567890abcdef

# Stripe Webhook Secret
# Get after creating webhook endpoint in Stripe Dashboard
